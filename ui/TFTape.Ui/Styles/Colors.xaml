<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Paleta base (dark theme) -->
    <Color x:Key="Color.Background">#FF0F172A</Color>
    <Color x:Key="Color.Surface">#FF0F174E</Color>
    <Color x:Key="Color.Primary">#FF2963AA</Color>
    <Color x:Key="Color.Accent">#FF0CDBEB</Color>
    <Color x:Key="Color.TextSecondary">#FF8699BA</Color>
    <Color x:Key="Color.TextPrimary">#FFE2E8F0</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.TextSecondary}" Opacity="0.18" />
</ResourceDictionary>
