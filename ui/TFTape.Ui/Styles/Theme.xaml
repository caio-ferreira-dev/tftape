<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="SecondaryText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SectionCaption" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- TabView: abas com fundo sutil mesmo quando inativas; seleção em azul primário com texto accent. -->
    <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="{StaticResource Color.Surface}" Opacity="0.45" />
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPointerOver" Color="{StaticResource Color.Surface}" Opacity="0.9" />
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundPressed" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="TabViewItemHeaderBackgroundSelected" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="TabViewItemHeaderForeground" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="TabViewItemHeaderForegroundPointerOver" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="TabViewItemHeaderForegroundSelected" Color="{StaticResource Color.Accent}" />
    <StaticResource x:Key="TabViewItemSeparator" ResourceKey="Brush.Divider" />
</ResourceDictionary>
