<Window
    x:Class="TFTape.Ui.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    xmlns:local="using:TFTape.Ui"
    Title="TFTape">
    <Grid Background="{StaticResource Brush.Background}" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.Resources>
            <local:MillisecondsToTimeConverter x:Key="MsToTime"/>
        </Grid.Resources>

        <!-- Barra de título própria: os botões do sistema continuam, mas com as cores do app e sem ícone. -->
        <Border x:Name="AppTitleBar" Height="40" Padding="16,0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Brush.Accent}"/>
                <TextBlock Text="TFTape" FontSize="13" FontWeight="SemiBold"
                           CharacterSpacing="60" VerticalAlignment="Center"/>
                <TextBlock Text="Gravação e VODs" Style="{StaticResource SecondaryText}"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Stretch explícito: sem ele o WinUI 3 mantém o conteúdo do TabView com a altura
             da janela anterior ao maximize/fullscreen. -->
        <muxc:TabView x:Name="MainTabs" Grid.Row="1" Margin="16,12,16,16"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      SelectionChanged="OnTabChanged"
                      IsAddTabButtonVisible="False" CanReorderTabs="False">

            <muxc:TabViewItem Header="Gravação" IsClosable="False"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Gravação" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Captura apenas a janela do Teamfight Tactics"
                                   Style="{StaticResource SecondaryText}"/>
                    </StackPanel>

                    <!-- Duas colunas de 460px + 12px de espaçamento = 932px, centralizadas na aba.
                         Os cartões mantêm esse tamanho mesmo no fullscreen. -->
                    <ScrollViewer Grid.Row="1" Margin="0,16,0,12"
                                  HorizontalScrollBarVisibility="Auto">
                        <Grid Width="932" HorizontalAlignment="Center" VerticalAlignment="Top">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="460"/>
                                <ColumnDefinition Width="460"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" VerticalAlignment="Top"
                                    Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="STATUS" Style="{StaticResource SectionCaption}"/>
                                    <Border Height="1" Background="{StaticResource Brush.Divider}"/>
                                    <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                                               Foreground="{StaticResource Brush.Accent}" FontSize="14"/>
                                    <TextBlock Text="{x:Bind ViewModel.Error, Mode=OneWay}"
                                               Foreground="{StaticResource Brush.Error}" FontSize="12" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind ViewModel.Warning, Mode=OneWay}"
                                               Foreground="{StaticResource Brush.Warning}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0"
                                    Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="VÍDEO" Style="{StaticResource SectionCaption}"/>
                                    <Border Height="1" Background="{StaticResource Brush.Divider}"/>
                                    <Grid HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="6" Margin="0,0,24,0">
                                            <TextBlock Text="Resolução" Style="{StaticResource SecondaryText}"/>
                                            <ComboBox ItemsSource="{x:Bind ViewModel.Resolutions}"
                                                      SelectedItem="{x:Bind ViewModel.Resolution, Mode=TwoWay}"
                                                      Width="160"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="6">
                                            <TextBlock Text="Framerate" Style="{StaticResource SecondaryText}"/>
                                            <ComboBox ItemsSource="{x:Bind ViewModel.FpsOptions}"
                                                      SelectedItem="{x:Bind ViewModel.Fps, Mode=TwoWay}"
                                                      Width="120"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="Padrão: 1080p a 30 fps." Style="{StaticResource SecondaryText}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" VerticalAlignment="Top" Margin="0,12,0,0"
                                    Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="DESTINO DA GRAVAÇÃO (.MP4)" Style="{StaticResource SectionCaption}"/>
                                    <Border Height="1" Background="{StaticResource Brush.Divider}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind ViewModel.OutputDirectory, Mode=TwoWay}"
                                                 PlaceholderText="Selecione a pasta de salvamento"
                                                 HorizontalAlignment="Stretch"/>
                                        <Button Grid.Column="1" Content="Escolher pasta" Click="OnPickFolder"
                                                Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{x:Bind ViewModel.LastFile, Mode=OneWay}"
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" VerticalAlignment="Top" Margin="12,12,0,0"
                                    Background="{StaticResource Brush.Surface}" CornerRadius="10" Padding="16">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="ÁUDIO" Style="{StaticResource SectionCaption}"/>
                                    <Border Height="1" Background="{StaticResource Brush.Divider}"/>
                                    <StackPanel Spacing="8">
                                        <CheckBox Content="Som do jogo (TFT) — padrão" IsChecked="{x:Bind ViewModel.GameAudio, Mode=TwoWay}"/>
                                        <CheckBox Content="Incluir som de outras janelas/sistema" IsChecked="{x:Bind ViewModel.SystemAudio, Mode=TwoWay}"/>
                                        <CheckBox Content="Incluir microfone" IsChecked="{x:Bind ViewModel.Microphone, Mode=TwoWay}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Rodapé sem cartão: apenas os botões, alinhados à direita do grupo. -->
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal"
                                        Spacing="8" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <Button Content="Parar" Command="{x:Bind ViewModel.StopCommand}"/>
                                <Button Content="Iniciar gravação" Command="{x:Bind ViewModel.StartCommand}"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </muxc:TabViewItem>

            <muxc:TabViewItem Header="VODs" IsClosable="False"
                              HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                <Grid Padding="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Cabeçalho da aba: título + seleção de pasta, alinhados em linhas distintas de informação. -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="VODs" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Biblioteca de gravações e metadados" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox Text="{x:Bind VodLibrary.Folder, Mode=TwoWay}" Width="320"
                                     PlaceholderText="Pasta com os arquivos .mp4"/>
                            <Button Content="Escolher pasta" Click="OnPickVodFolder"/>
                            <Button Content="Atualizar" Command="{x:Bind VodLibrary.RefreshCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coluna esquerda: seleção, lista e status com hierarquia visual clara. -->
                        <Border Grid.Column="0" Background="{StaticResource Brush.Surface}"
                                CornerRadius="10" Padding="12" Margin="0,0,12,0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="SELECIONADO" Style="{StaticResource SectionCaption}"/>
                                <StackPanel Grid.Row="1" Spacing="2" Margin="0,6,0,10">
                                    <TextBlock Text="{x:Bind VodLibrary.SelectedFileName, Mode=OneWay}"
                                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{x:Bind VodLibrary.SelectedMetaLine, Mode=OneWay}"
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                </StackPanel>

                                <Border Grid.Row="2" Height="1" Background="{StaticResource Brush.Divider}" Margin="0,0,0,10"/>

                                <TextBlock Grid.Row="3" Text="GRAVAÇÕES" Style="{StaticResource SectionCaption}" Margin="0,0,0,6"/>
                                <ListView Grid.Row="4" x:Name="VodList"
                                          ItemsSource="{x:Bind VodLibrary.Vods, Mode=OneWay}"
                                          SelectedItem="{x:Bind VodLibrary.SelectedVod, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Padding="10,8" Spacing="2">
                                                <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding MetaLine}" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding LoadError}" Foreground="{StaticResource Brush.Warning}" FontSize="11" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <StackPanel Grid.Row="5" Spacing="4" Margin="0,10,0,0">
                                    <TextBlock Text="{x:Bind VodLibrary.Status, Mode=OneWay}" Foreground="{StaticResource Brush.Accent}" FontSize="12"/>
                                    <TextBlock Text="{x:Bind VodLibrary.Error, Mode=OneWay}" Foreground="{StaticResource Brush.Error}" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Coluna direita: player e, logo abaixo, os marcadores do vídeo atual. -->
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- O quadro é dimensionado na proporção real do vídeo (sidecar ou NaturalVideoSize). -->
                            <Grid x:Name="VodPlayerViewport"
                                  SizeChanged="OnVodViewportSizeChanged"
                                  PointerMoved="OnVodPointerMoved"
                                  PointerEntered="OnVodPointerEntered"
                                  PointerExited="OnVodPointerExited">
                                <Border x:Name="VodPlayerFrame"
                                        Background="{StaticResource Brush.Background}"
                                        CornerRadius="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <Grid>
                                        <muxc:MediaPlayerElement x:Name="VodPlayer"
                                                                 AreTransportControlsEnabled="False"
                                                                 Stretch="Uniform"
                                                                 HorizontalAlignment="Stretch"
                                                                 VerticalAlignment="Stretch"
                                                                 Tapped="OnVodSurfaceTapped"/>

                                        <!-- Barra de ações customizada: transparente, fixa na base e sem botão de transmitir. -->
                                        <Grid x:Name="VodControlBar"
                                              VerticalAlignment="Bottom"
                                              Background="Transparent"
                                              Padding="20,0,20,14"
                                              Visibility="Visible">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Sem Height fixo: a altura padrão evita que o thumb seja cortado. -->
                                            <Slider x:Name="VodTimeline"
                                                    Minimum="0" Maximum="1" Value="0" Margin="0,0,0,2"
                                                    ThumbToolTipValueConverter="{StaticResource MsToTime}"
                                                    ValueChanged="OnVodTimelineValueChanged"/>

                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <Button x:Name="VodPlayPauseButton"
                                                        Width="40" Height="40" Padding="0" CornerRadius="20"
                                                        FontSize="18"
                                                        Background="Transparent" BorderThickness="0"
                                                        Click="OnVodPlayPauseClick">
                                                    <SymbolIcon x:Name="VodPlayPauseIcon" Symbol="Play"/>
                                                </Button>
                                                <TextBlock x:Name="VodTimeText" Grid.Column="1"
                                                           VerticalAlignment="Center" Margin="12,0"
                                                           Foreground="{StaticResource Brush.TextPrimary}" FontSize="12"/>
                                                <Slider x:Name="VodVolume"
                                                        Grid.Column="3" Width="110"
                                                        Minimum="0" Maximum="100" Value="100"
                                                        ValueChanged="OnVodVolumeValueChanged"/>
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Marcadores do vídeo selecionado: abaixo do player, com o mesmo
                                 espaçamento/cartão das demais seções da aba. -->
                            <Border Grid.Row="1" Background="{StaticResource Brush.Surface}"
                                    CornerRadius="10" Padding="12,10" Margin="0,12,0,0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="ROUNDS" Style="{StaticResource SectionCaption}" Margin="0,0,0,8"/>
                                    <ScrollViewer Grid.Row="1" HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                                        <!-- Margem inferior reserva o espaço da barra horizontal, que no
                                             WinUI é desenhada sobre a área de conteúdo do ScrollViewer. -->
                                        <ItemsControl ItemsSource="{x:Bind VodLibrary.SelectedRounds, Mode=OneWay}"
                                                      Margin="0,0,0,16">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Content="{Binding Label}" MinWidth="56" Padding="10,6" FontSize="12" Click="OnRoundClick"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                    <TextBlock Grid.Row="2" Text="{x:Bind VodLibrary.RoundsHint, Mode=OneWay}"
                                               Style="{StaticResource SecondaryText}" TextWrapping="Wrap"
                                               Margin="0,8,0,0"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </muxc:TabViewItem>
        </muxc:TabView>
    </Grid>
</Window>
